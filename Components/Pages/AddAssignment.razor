@page "/assignments/add"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using StudentAssignmentTracker.Data
@using StudentAssignmentTracker.Enums
@using StudentAssignmentTracker.Models
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Add Assignment - Student Assignment Tracker</PageTitle>

<div class="add-assignment-page">
    <div class="page-header">
        <div>
            <h1>Add Assignment</h1>
            <p>Add a new assignment and keep track of its deadline.</p>
        </div>
        <a href="/assignments" class="back-button">← Back to Assignments</a>
    </div>

    @if (courses.Count == 0)
    {
        <div class="alert alert-info">
            Add a course before creating an assignment. <a href="/courses/add">Add Course</a>
        </div>
    }
    else
    {
        <div class="assignment-form-card">
            <EditForm Model="@assignment" OnValidSubmit="HandleAddAssignment" FormName="AddAssignmentForm">
                <DataAnnotationsValidator />
                <ValidationSummary />

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <div class="form-group">
                    <label for="title">Assignment Title</label>
                    <InputText id="title" @bind-Value="assignment.Title" class="form-control"
                               placeholder="e.g. Database Design Project" />
                    <ValidationMessage For="@(() => assignment.Title)" />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="course">Course</label>
                        <InputSelect id="course" @bind-Value="assignment.CourseId" class="form-select">
                            <option value="">Select a course</option>
                            @foreach (var course in courses)
                            {
                                <option value="@course.Id">@course.Code - @course.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => assignment.CourseId)" />
                    </div>

                    <div class="form-group">
                        <label for="dueDate">Due Date</label>
                        <InputDate id="dueDate" @bind-Value="assignment.DueDate" class="form-control" />
                        <ValidationMessage For="@(() => assignment.DueDate)" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="priority">Priority</label>
                        <InputSelect id="priority" @bind-Value="assignment.Priority" class="form-select">
                            @foreach (var priority in Enum.GetValues<PriorityLevel>())
                            {
                                <option value="@priority">@priority</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="form-group">
                        <label for="status">Status</label>
                        <InputSelect id="status" @bind-Value="assignment.Status" class="form-select">
                            <option value="@AssignmentStatus.NotStarted">Not Started</option>
                            <option value="@AssignmentStatus.InProgress">In Progress</option>
                            <option value="@AssignmentStatus.Completed">Completed</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <InputTextArea id="description" @bind-Value="assignment.Description" class="form-control"
                                   placeholder="Enter assignment details..." />
                    <ValidationMessage For="@(() => assignment.Description)" />
                </div>

                <div class="form-actions">
                    <a href="/assignments" class="cancel-button">Cancel</a>
                    <button type="submit" class="submit-button">Add Assignment</button>
                </div>
            </EditForm>
        </div>
    }
</div>

@code {
    private List<Course> courses = [];
    private AssignmentFormModel assignment = new()
    {
        DueDate = DateTime.Today.AddDays(7),
        Priority = PriorityLevel.Medium,
        Status = AssignmentStatus.NotStarted
    };
    private string? errorMessage;
    private string userId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier)
            ?? throw new InvalidOperationException("The signed-in user has no identifier claim.");
        courses = await DbContext.Courses
            .Where(course => course.UserId == userId)
            .OrderBy(course => course.Name)
            .ToListAsync();
    }

    private async Task HandleAddAssignment()
    {
        // Only accept courses loaded for this user; do not trust a submitted course ID alone.
        var course = courses.SingleOrDefault(item => item.Id == assignment.CourseId);
        if (course is null)
        {
            errorMessage = "Select one of your courses for this assignment.";
            return;
        }

        var newAssignment = new Assignment
        {
            Title = assignment.Title,
            Description = assignment.Description,
            DueDate = assignment.DueDate!.Value,
            Priority = assignment.Priority,
            Status = assignment.Status,
            IsCompleted = assignment.Status == AssignmentStatus.Completed,
            CourseId = course.Id
        };

        DbContext.Assignments.Add(newAssignment);
        await DbContext.SaveChangesAsync();
        NavigationManager.NavigateTo("/assignments");
    }

    private sealed class AssignmentFormModel
    {
        [Required(ErrorMessage = "Assignment title is required.")]
        [StringLength(100)]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please select a course.")]
        public int? CourseId { get; set; }

        [Required(ErrorMessage = "Due date is required.")]
        public DateTime? DueDate { get; set; }

        public PriorityLevel Priority { get; set; }

        public AssignmentStatus Status { get; set; }

        [StringLength(1000)]
        public string Description { get; set; } = string.Empty;
    }
}
