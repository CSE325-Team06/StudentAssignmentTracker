@page "/"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using StudentAssignmentTracker.Data
@using StudentAssignmentTracker.Enums
@using StudentAssignmentTracker.Models
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard - Student Assignment Tracker</PageTitle>

<div class="dashboard">
    <div class="dashboard-header">
        <div>
            <h1>Dashboard</h1>
            <p>Here's an overview of your courses and upcoming assignments.</p>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-card blue">
            <div class="stat-icon">📚</div>
            <div><span>Total Courses</span><strong>@courseCount</strong></div>
        </div>
        <div class="stat-card green">
            <div class="stat-icon">✓</div>
            <div><span>Total Assignments</span><strong>@assignments.Count</strong></div>
        </div>
        <div class="stat-card yellow">
            <div class="stat-icon">◷</div>
            <div><span>Upcoming Assignments</span><strong>@UpcomingAssignments.Count</strong></div>
        </div>
        <div class="stat-card purple">
            <div class="stat-icon">✓</div>
            <div><span>Completed Assignments</span><strong>@assignments.Count(IsCompleted)</strong></div>
        </div>
    </div>

    <div class="dashboard-content">
        <section class="assignments-card">
            <div class="section-header">
                <h2>Upcoming Assignments</h2>
                <a href="/assignments">View All →</a>
            </div>

            @if (UpcomingAssignments.Count == 0)
            {
                <p>You have no upcoming assignments. <a href="/assignments/add">Add one</a>.</p>
            }
            else
            {
                <div class="assignment-list">
                    @foreach (var assignment in UpcomingAssignments.Take(5))
                    {
                        <div class="assignment-item">
                            <div class="assignment-info">
                                <strong>@assignment.Title</strong>
                                <span>@assignment.Course.Code · @assignment.Course.Name</span>
                            </div>
                            <div class="assignment-date">
                                <span>@assignment.DueDate.ToString("MMM d, yyyy")</span>
                            </div>
                            <span class="priority @assignment.Priority.ToString().ToLowerInvariant()">
                                @assignment.Priority
                            </span>
                        </div>
                    }
                </div>
            }
        </section>

        <div class="right-column">
            <section class="quick-actions">
                <h2>Quick Actions</h2>
                <a href="/courses/add">
                    <span class="action-icon blue-icon">+</span>
                    Add Course
                    <span>›</span>
                </a>
                <a href="/assignments/add">
                    <span class="action-icon green-icon">+</span>
                    Add Assignment
                    <span>›</span>
                </a>
                <a href="/calendar">
                    <span class="action-icon purple-icon">◷</span>
                    View Calendar
                    <span>›</span>
                </a>
            </section>
        </div>
    </div>
</div>

@code {
    private int courseCount;
    private List<Assignment> assignments = [];

    private List<Assignment> UpcomingAssignments => assignments
        .Where(assignment => !IsCompleted(assignment) && assignment.DueDate.Date >= DateTime.Today)
        .OrderBy(assignment => assignment.DueDate)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrEmpty(userId))
        {
            throw new InvalidOperationException("The signed-in user has no identifier claim.");
        }

        // Keep dashboard totals and assignment details scoped to the signed-in user.
        courseCount = await DbContext.Courses.CountAsync(course => course.UserId == userId);
        assignments = await DbContext.Assignments
            .Include(assignment => assignment.Course)
            .Where(assignment => assignment.Course.UserId == userId)
            .OrderBy(assignment => assignment.DueDate)
            .ToListAsync();
    }

    private static bool IsCompleted(Assignment assignment) =>
        assignment.IsCompleted || assignment.Status == AssignmentStatus.Completed;
}
