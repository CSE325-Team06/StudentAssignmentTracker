@page "/courses"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using StudentAssignmentTracker.Data
@using StudentAssignmentTracker.Models
@inject ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Courses - Student Assignment Tracker</PageTitle>

<div class="courses-page">
    <div class="page-header">
        <div>
            <h1>My Courses</h1>
            <p>Manage your courses and keep track of your academic schedule.</p>
        </div>
        <a href="/courses/add" class="add-course-button">+ Add Course</a>
    </div>

    <div class="courses-toolbar">
        <div class="search-box">
            <input type="search" placeholder="Search courses..." @bind="searchTerm" @bind:event="oninput" />
        </div>
    </div>

    @if (FilteredCourses.Count == 0)
    {
        <p>@(string.IsNullOrWhiteSpace(searchTerm) ? "You have no courses yet." : "No courses match your search.")</p>
    }
    else
    {
        <div class="courses-grid">
            @foreach (var course in FilteredCourses)
            {
                <article class="course-card" @key="course.Id">
                    <div class="course-card-header">
                        <span class="course-code">@course.Code</span>
                    </div>
                    <h2>@course.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(course.Description))
                    {
                        <p class="instructor">@course.Description</p>
                    }
                    <div class="course-card-footer">
                        <span>@course.Assignments.Count assignment(s)</span>
                        <span>@course.Semester</span>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private List<Course> courses = [];
    private string searchTerm = string.Empty;

    private List<Course> FilteredCourses => courses
        .Where(course =>
            string.IsNullOrWhiteSpace(searchTerm) ||
            course.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            course.Code.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            course.Semester.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (string.IsNullOrEmpty(userId))
        {
            throw new InvalidOperationException("The signed-in user has no identifier claim.");
        }

        courses = await DbContext.Courses
            .Where(course => course.UserId == userId)
            .Include(course => course.Assignments)
            .OrderBy(course => course.Name)
            .ToListAsync();
    }
}
