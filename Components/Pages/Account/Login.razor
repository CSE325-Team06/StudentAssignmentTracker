@page "/account/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Microsoft.AspNetCore.Components
@using StudentAssignmentTracker.Interfaces
@using StudentAssignmentTracker.ViewModels
@using StudentAssignmentTracker.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Log in</PageTitle>

<div class="container py-4">
	<div class="row justify-content-center">
		<div class="col-12 col-md-8 col-lg-6">
			<div class="card shadow-sm">
				<div class="card-body p-4">
					<h1 class="h3 mb-4">Log in</h1>

					<EditForm Model="Input!" OnValidSubmit="LoginAsync" FormName="login">
						<DataAnnotationsValidator />
						<ValidationSummary class="alert alert-danger" />

						@if (!string.IsNullOrEmpty(ErrorMessage))
						{
							<div class="alert alert-danger" role="alert">@ErrorMessage</div>
						}

						<div class="row g-3">
							<div class="col-12">
								<label for="email" class="form-label">Email</label>
								<InputText id="email" type="email" class="form-control" @bind-Value="Input!.Email" autocomplete="username" />
								<ValidationMessage For="@(() => Input!.Email)" />
							</div>

							<div class="col-12">
								<label for="password" class="form-label">Password</label>
								<InputText id="password" type="password" class="form-control" @bind-Value="Input!.Password" autocomplete="current-password" />
								<ValidationMessage For="@(() => Input!.Password)" />
							</div>

							<div class="col-12">
								<div class="form-check">
									<InputCheckbox id="rememberMe" class="form-check-input" @bind-Value="Input!.RememberMe" />
									<label for="rememberMe" class="form-check-label">Remember me</label>
								</div>
							</div>

							<div class="col-12">
								<button type="submit" class="btn btn-primary w-100">Log in</button>
							</div>
						</div>
					</EditForm>

					<p class="mt-3 mb-0 text-center">
						Need an account? <a href="/account/register">Register</a>
					</p>
				</div>
			</div>
		</div>
	</div>
</div>

@code {
	[SupplyParameterFromForm]
	private LoginViewModel? Input { get; set; }

	private string? ErrorMessage { get; set; }

	protected override void OnInitialized()
	{
		Input ??= new();
	}

	private async Task LoginAsync()
	{
		var input = Input!;
		var result = await AuthService.LoginAsync(input);

		if (result.Succeeded)
		{
			Navigation.NavigateTo("/", forceLoad: true);
			return;
		}

		ErrorMessage = result.IsLockedOut
			? "This account is locked. Try again later."
			: "Invalid email or password.";
	}
}
